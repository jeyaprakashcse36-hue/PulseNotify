{
  "info": {
    "name": "PulseNotify API Tests",
    "description": "Postman collection for PulseNotify flight price monitoring API. Set base_url to http://127.0.0.1:8000. Register and login requests save the returned access token to user_token. Set admin_token manually to an access token belonging to a user whose profile role is ADMIN to test the admin summary endpoint.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "username",
      "value": "pulse_test_user"
    },
    {
      "key": "password",
      "value": "PulseTestPass123!"
    },
    {
      "key": "email",
      "value": "pulse_test_user@example.com"
    },
    {
      "key": "user_token",
      "value": ""
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "alert_id",
      "value": ""
    },
    {
      "key": "other_alert_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Register user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/register/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "register"
          ]
        },
        "description": "Creates a standard USER account. If this username already exists, change the username/email collection variables before rerunning.",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Registration returns 201\", function () { pm.response.to.have.status(201); });",
              "let data = pm.response.json();",
              "if (data.access) pm.collectionVariables.set(\"user_token\", data.access);",
              "if (data.user && data.user.id) pm.collectionVariables.set(\"user_id\", String(data.user.id));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Duplicate registration (expected 400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/register/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "register"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Duplicate username is rejected\", function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Login valid user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/login/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "login"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login succeeds\", function () { pm.response.to.have.status(200); });",
              "let data = pm.response.json();",
              "if (data.access) pm.collectionVariables.set(\"user_token\", data.access);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Login invalid password (expected 401)",
