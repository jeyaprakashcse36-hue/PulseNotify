      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"List alerts succeeds\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Public flight price valid route",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/flights/price/?route=MAA-DEL",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "flights",
            "price",
            "?route=MAA-DEL"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Known route returns price\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Response contains price\", function () { pm.expect(pm.response.json()).to.have.property(\"price\"); });"
            ]
          }
        }
      ]
    },
